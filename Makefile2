CC = gcc
CLANG = clang

# ========== ASAN 配置（只给 server 用） ==========
ASAN_FLAGS = -fsanitize=address -fno-omit-frame-pointer -g

CFLAGS = -Wall -g -I ./NtyCo/core/
CFLAGS_ASAN = $(CFLAGS) $(ASAN_FLAGS)

LDFLAGS = -L ./NtyCo/ -lntyco -lpthread -luring -ldl -libverbs -lrdmacm
LDFLAGS_ASAN = $(LDFLAGS) $(ASAN_FLAGS)

BPF_LDFLAGS = -lbpf -lelf -lz

BPF_CFLAGS = -target bpf -D__TARGET_ARCH_x86 -I/usr/include/x86_64-linux-gnu -I/usr/include -g -O2 -Wall

SRCS = server.c kvstore.c mempool.c persistence.c snapshot.c reactor.c proactor.c ntyco.c resp.c \
       kvs_array.c kvs_rbtree.c kvs_hash.c kvs_skiptable.c kv_utils.c config.c\
       rdma.c repl.c expire.c

TARGET = server

RELAY_TARGET = ebpf_relay

# ========== eBPF 文件定义（统一使用 relay 版本） ==========
BPF_KERN_SRC = ebpf_relay_kern.c
BPF_KERN_OBJ = ebpf_relay_kern.o
EBPF_RELAY_SRC = ebpf_relay.c
EBPF_RELAY_OBJ = ebpf_relay.o

TESTCASES = test_fullpersistence1 test_fullpersistence2 test_incrementpersistence1 \
            test_incrementpersistence2 test_mempool test_master test_slave test_TTL \
            test_batchcommand test_specialchars test_save test_1G test_transport

SUBDIR = ./NtyCo/

OBJS = server.o kvstore.o mempool.o persistence.o snapshot.o reactor.o proactor.o ntyco.o resp.o \
       kvs_array.o kvs_rbtree.o kvs_hash.o kvs_skiptable.o kv_utils.o config.o\
       rdma.o repl.o expire.o

.PHONY: all clean ECHO $(SUBDIR) load_bpf unload_bpf asan reload_bpf run_relay test_relay

# ========== 默认编译（不带 ASAN） ==========
all: $(SUBDIR) $(BPF_KERN_OBJ) $(TARGET) $(RELAY_TARGET) $(TESTCASES)

# ========== 带 ASAN 编译 ==========
asan:
	@echo "========================================="
	@echo "  Compiling with AddressSanitizer (ASAN)"
	@echo "========================================="
	@$(MAKE) all CFLAGS="$(CFLAGS_ASAN)" LDFLAGS="$(LDFLAGS_ASAN)"

$(SUBDIR): ECHO
	make -C $@

ECHO:
	@echo $(SUBDIR)

# ========== eBPF 编译 ==========
# eBPF 内核字节码编译（唯一的BPF程序）
$(BPF_KERN_OBJ): $(BPF_KERN_SRC)
	$(CLANG) $(BPF_CFLAGS) -c $< -o $@
	@echo "✨ eBPF Relay kernel bytecode compiled: $@"

# 主服务器程序
$(TARGET): $(OBJS)
	$(CC) -o $@ $(OBJS) $(LDFLAGS)
	@echo "✨ Server compiled: $@"

# eBPF 用户态中继程序（不用 ASAN）
$(RELAY_TARGET): $(EBPF_RELAY_OBJ)
	$(CC) -o $@ $< $(BPF_LDFLAGS)
	@echo "✨ eBPF Relay user-space program compiled: $@"

# ebpf_relay.o 永远不用 ASAN
$(EBPF_RELAY_OBJ): $(EBPF_RELAY_SRC)
	$(CC) $(CFLAGS) -c $< -o $@
	@echo "  ↳ ebpf_relay.o compiled"

# 测试用例（不用 ASAN）
$(TESTCASES): %: %.c
	$(CC) $(CFLAGS) -o $@ $<

# 通用 .c -> .o 编译规则
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

IFACE = ens33

# ========== eBPF 加载/卸载 ==========
load_bpf: $(BPF_KERN_OBJ)
	@echo "========================================="
	@echo "  加载 eBPF Relay 程序到内核"
	@echo "========================================="
	@sudo rm -rf /sys/fs/bpf/* 2>/dev/null || true
	@echo "📦 加载 BPF 程序并固定 Maps..."
	sudo bpftool prog load $(BPF_KERN_OBJ) \
		/sys/fs/bpf/ebpf_relay_handler \
		type classifier \
		pinmaps /sys/fs/bpf/
	@echo "🔧 配置 TC 过滤器..."
	sudo tc qdisc add dev $(IFACE) clsact 2>/dev/null || true
	sudo tc filter replace dev $(IFACE) ingress \
		bpf pinned /sys/fs/bpf/ebpf_relay_handler \
		direct-action
	@echo ""
	@echo "✅ eBPF Relay 已成功加载！"
	@echo ""
	@echo "可用的 BPF Maps:"
	@ls -la /sys/fs/bpf/ | grep -v "^total" | awk '{print "  - " $$NF}'

unload_bpf:
	@echo "========================================="
	@echo "  清理内核 eBPF 残留"
	@echo "========================================="
	sudo tc filter del dev $(IFACE) ingress 2>/dev/null || true
	sudo tc qdisc del dev $(IFACE) clsact 2>/dev/null || true
	sudo rm -rf /sys/fs/bpf/* 2>/dev/null || true
	@echo "✅ 内核环境已恢复"

reload_bpf: unload_bpf load_bpf
	@echo ""
	@echo "✅ eBPF 程序重新加载完成！"

# ========== 运行 eBPF Relay ==========
run_relay: $(RELAY_TARGET)
	@echo "========================================="
	@echo "  启动 eBPF Relay 用户态程序"
	@echo "========================================="
	@echo "  按 Ctrl+C 触发优雅退出 (drain mode)"
	@echo "========================================="
	@echo ""
	sudo ./$(RELAY_TARGET)

# ========== 一键测试 ==========
test_relay: reload_bpf
	@echo ""
	@echo "⏳ 等待 1 秒让 BPF 程序就绪..."
	@sleep 1
	@$(MAKE) run_relay

# ========== 状态检查 ==========
status_bpf:
	@echo "========================================="
	@echo "  eBPF 状态检查"
	@echo "========================================="
	@echo ""
	@echo "1. BPF 程序:"
	@sudo bpftool prog show | grep ebpf_relay || echo "  未找到 eBPF Relay 程序"
	@echo ""
	@echo "2. BPF Maps:"
	@sudo bpftool map show | grep -A 1 "payload_ringbuf\|seq_counter\|lost_counter" || echo "  未找到相关 Maps"
	@echo ""
	@echo "3. TC 过滤器:"
	@sudo tc filter show dev $(IFACE) ingress 2>/dev/null || echo "  未找到 TC 过滤器"
	@echo ""
	@echo "4. Map 统计:"
	@echo -n "  序列号: "
	@sudo bpftool map dump name seq_counter 2>/dev/null | grep -oP '"value": \K\d+' || echo "N/A"
	@echo -n "  丢失数: "
	@sudo bpftool map dump name lost_counter 2>/dev/null | grep -oP '"value": \K\d+' || echo "N/A"
	@echo -n "  事件数: "
	@sudo bpftool map dump name event_counter 2>/dev/null | grep -oP '"value": \K\d+' || echo "N/A"

# ========== 脚本执行 ==========
batchcommand:
	@if [ -f "./batchcommand.sh" ]; then \
		chmod +x ./batchcommand.sh; \
		./batchcommand.sh; \
	else \
		echo "❌ 错误: 当前目录下未找到 batchcommand.sh 脚本！"; \
	fi

incrementpersistence:
